PARTNER_API_TOKEN=securetoken123

curl -H "Authorization: Bearer YOUR_JWT_TOKEN" http://localhost:3000/api/partners

curl -X GET "http://localhost:3000/api/v1/appointments?date=2025-10-25" ^
  -H "Authorization: Bearer securetoken123"

curl -X GET "http://localhost:3000/api/v1/calendar?doctor=Dr.%20Santos&date=2025-10-25" ^
  -H "Authorization: Bearer securetoken123"

curl -X POST http://localhost:3000/api/v1/appointments ^
  -H "Authorization: Bearer securetoken123" ^
  -H "Content-Type: application/json" ^
  -d "{\"patient\":\"Zenitsu\",\"doctor\":\"Dr. Santos\",\"time\":\"2025-10-27T14:00:00\",\"status\":\"Confirmed\"}"

  curl -X DELETE http://localhost:3000/api/v1/appointments/1 ^
  -H "Authorization: Bearer securetoken123"